# ============================================================
# TradingBot — Environment Variables Template
# Copy to .env and fill in your values. NEVER commit .env!
# ============================================================

# --- Broker: Alpaca (US Stocks/ETFs) ---
ALPACA_API_KEY=your_alpaca_api_key
ALPACA_SECRET_KEY=your_alpaca_secret_key
ALPACA_BASE_URL=https://paper-api.alpaca.markets   # Use paper for testing

# --- Broker: Binance (Crypto) ---
BINANCE_API_KEY=your_binance_api_key
BINANCE_SECRET_KEY=your_binance_secret_key
BINANCE_TESTNET=true   # Set false for live trading

# --- Broker: Kraken (Crypto, CH-friendly) ---
KRAKEN_API_KEY=your_kraken_api_key
KRAKEN_SECRET_KEY=your_kraken_secret_key

# --- News & Sentiment ---
NEWS_API_KEY=your_newsapi_org_key
ALPHA_VANTAGE_KEY=your_alpha_vantage_key

# --- Congress Trades (QuiverQuant) ---
QUIVER_API_KEY=your_quiverquant_api_key

# --- Notifications (optional) ---
TELEGRAM_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# --- Database ---
DATABASE_URL=sqlite:///logs/trading_bot.db

# --- Environment ---
TRADING_ENV=paper    # paper | live
LOG_LEVEL=INFO
